# clock.nova - the clock reader (Stats: Modules/Clock).
# The local time comes from format_time(), which follows the machine's zone and its daylight saving. The other
# cities are fixed UTC offsets with no daylight-saving rules (docs/GAPS.md G-014: std:date deliberately has no zone
# database). Everything else is std:date: a world time is the same instant written in another offset, and the
# local offset is how far the machine's wall clock is from UTC at this instant.
import "../kit.nova" as kit
import "std:date" as date

let WALL_FORMAT = "%Y-%m-%dT%H:%M:%S"

# A UTC offset in hours (5.5, -5, 12.75) as std:date writes it: "+05:30", "-05:00", "+12:45".
def offset_text(hours) {
    let minutes = round(abs(hours) * 60)
    let sign = "+"
    if hours < 0 {
        sign = "-"
    }
    return sign + kit.two(minutes // 60) + ":" + kit.two(minutes % 60)
}

def at_offset(wall, hours) {
    return date.format(date.from_epoch(floor(wall), offset_text(hours)), "%H:%M")
}

# The local UTC offset in hours: the machine's wall clock read as if it were UTC, minus the real UTC instant.
def local_offset(wall) {
    let seconds = floor(wall)
    let local = date.parse_timestamp_at(format_time(seconds, WALL_FORMAT), WALL_FORMAT, "+00:00")
    return date.diff_seconds(local, date.from_epoch(seconds, "+00:00")) / 3600
}

export def sample(ctx, state) {
    let wall = ctx.wall
    let zones = [
        {name: "UTC", offset: 0},
        {name: "New York", offset: -5},
        {name: "London", offset: 0},
        {name: "Tokyo", offset: 9}
    ]
    let world = []
    for z in zones {
        world = world + [{name: z.name, offset: z.offset, time: at_offset(wall, z.offset)}]
    }
    return {
        time: format_time(wall, "%H:%M:%S"),
        date: format_time(wall, "%Y-%m-%d"),
        utc_offset_hours: local_offset(wall),
        world: world
    }
}
